generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JSA
  ADMIN
}
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
enum ServiceType {
  FullValue
  UBR
  P2
  UninstalationIDUSTB
  UninstalationODU
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum AttendanceStatus {
  Present
  Absent
  Half_Day
  Late
  Leave
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  password  String
  phone     String? @unique
  role      Role    @default(JSA)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  WorkOrders WorkDetails[]
  BankInfo  BankDetails?
  attendences Attendance[]

  @@index([role])
}

model WorkDetails{
  id          Int      @id @default(autoincrement())
  userId      Int
  caustomerName String
  PhoneNumber String
  Address    String?
  BuildingId String
  Date   DateTime
  PaymentStatus PaymentStatus @default(PENDING)
  ApprovalStatus ApprovalStatus @default(PENDING)
  ServiceType  ServiceType  @default(FullValue)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([ApprovalStatus])
}

model BankDetails {
  id            Int      @id @default(autoincrement())
  accountNumber String   @unique
  bankName      String
  ifscCode      String
  accountHolder String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
}

model Attendance {
  attendance_id    BigInt   @id @default(autoincrement())
  userId      Int

  attendance_date  DateTime @db.Date
  mark_in          DateTime? @db.Time
  mark_out         DateTime? @db.Time

  status           AttendanceStatus @default(Absent)
  approval_status  ApprovalStatus   @default(PENDING)

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, attendance_date])
  @@index([userId, attendance_date])
}

model Latest_news {
  id       Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}